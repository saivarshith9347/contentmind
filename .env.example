# =============================================================================
# CONTENTMIND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Authentication & Database)
# -----------------------------------------------------------------------------
# These are PUBLIC variables - exposed to the browser
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# -----------------------------------------------------------------------------
# HINDSIGHT CLOUD (AI Memory System)
# -----------------------------------------------------------------------------
# These are SERVER-ONLY secrets - never exposed to browser
# Get your API key from: https://hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key-here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=contentmind

# -----------------------------------------------------------------------------
# GROQ (LLM Strategy Generation)
# -----------------------------------------------------------------------------
# This is a SERVER-ONLY secret - never exposed to browser
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 
# FOR LOCAL DEVELOPMENT:
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. Never commit .env.local to Git
#
# FOR VERCEL DEPLOYMENT:
# 1. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 2. Add all variables above with your actual values
# 3. Mark HINDSIGHT_API_KEY and GROQ_API_KEY as "Encrypted"
# 4. Set for "Production", "Preview", and "Development" environments
#
# SECURITY:
# - NEXT_PUBLIC_* variables are safe to expose (protected by RLS)
# - Non-NEXT_PUBLIC_* variables are server-only secrets
# - Never use NEXT_PUBLIC_ prefix for API keys or secrets
# =============================================================================
